# ==============================================================================
# VERITY - Production Environment Configuration Template
# Copy this file to .env before starting the production deployment
# ==============================================================================

# Application Environment (production / staging / development)
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Backend Host & Port Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Enterprise CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:80", "http://localhost"]

# Local Ollama AI Engine (Host Gateway Mapping)
# In Docker, host.docker.internal reaches the host OS Ollama daemon
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Local CPU-based Embedding Model (Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent Storage Locations
SQLITE_DB_PATH=/app/data/sqlite/verity.db
FAISS_INDEX_PATH=/app/data/faiss/index.faiss
UPLOAD_DIR=/app/data/uploads
QUARANTINE_DIR=/app/data/quarantine

# Security Authentication & Role-Based Access Control (RBAC) Keys
# CRITICAL: Replace these with strong, randomly generated secrets in production!
ADMIN_API_KEY=verity-admin-production-secret-change-me
AUDITOR_API_KEY=verity-auditor-production-secret-change-me
USER_API_KEY=verity-user-production-secret-change-me

# Security Policy Configuration
MAX_UPLOAD_SIZE_BYTES=26214400
ANTIVIRUS_FAIL_CLOSED=true
RATE_LIMIT_PER_MINUTE=120

