# ==============================================================================
# VERITY — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Runtime Storage, Databases & Model Caches
# ------------------------------------------------------------------------------
data/sqlite/*.db
data/sqlite/*.db-wal
data/sqlite/*.db-shm
data/sqlite/*.sqlite
data/sqlite/*.sqlite3
data/faiss/*.index
data/faiss/*.bin
data/faiss/*.faiss
data/faiss/*.pkl
data/faiss/*.json
data/uploads/*
data/quarantine/*
data/backups/
models/
*.gguf
*.bin
*.pt
*.onnx

# Preserve Directory Structure via .gitkeep
!data/sqlite/.gitkeep
!data/faiss/.gitkeep
!data/uploads/.gitkeep
!data/quarantine/.gitkeep

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.swp
*.bak

# ------------------------------------------------------------------------------
# 7. IDE & OS Metadata
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
