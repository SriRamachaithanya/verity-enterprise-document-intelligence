# ==============================================================================
# Verity - Enterprise Document Intelligence & Compliance Agent Environment Config
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Local AI / LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Recommended lightweight model for 8GB RAM + CPU execution:
OLLAMA_MODEL=qwen2.5:1.5b
# Embedding Model (Sentence Transformers runs locally on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Indexing Paths
SQLITE_DB_PATH=data/sqlite/verity.db
FAISS_INDEX_PATH=data/faiss/index.faiss
UPLOAD_DIR=data/uploads

# MCP Server Configuration
MCP_SERVER_NAME=verity-compliance-mcp
MCP_SERVER_PORT=8001

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

